---
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { formatUrl } from "@/lib/utils/urlFormatter";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

const allAuthors = await getSinglePage("authors");
const posts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.slug);
const { Content } = await render(post);
const { title, description, authors, categories, image, date, tags } =
  post.data;
---

<section class="section py-12">
  <div class="container max-w-[900px]">
    <article class="flex flex-col items-center">
      <div class="w-full text-center mb-8">
        <h1 set:html={markdownify(title)} class="text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6" />
        <div class="flex flex-wrap items-center justify-center gap-6 font-mono text-xs text-slate-400">
          <div>
            {
              allAuthors
                .filter((author) =>
                  authors
                    .map((author: string) => slugify(author))
                    .includes(slugify(author.data.title))
                )
                .map((author) => (
                  <a
                    href={formatUrl(`/authors/${slugify(author.id)}`)}
                    class="flex items-center text-slate-300 hover:text-white font-medium transition-colors"
                  >
                    {author.data.image && (
                      <Image
                        src={formatUrl(author.data.image)}
                        alt={author.data.title}
                        height={40}
                        width={40}
                        class="mr-2 h-6 w-6 rounded-full border border-white/10"
                      />
                    )}
                    <span>{author.data.title}</span>
                  </a>
                ))
            }
          </div>
          <div class="flex items-center text-slate-400">
            <BiCalendarEdit className="mr-1.5 h-4 w-4 text-slate-400" />
            {dateFormat(date)}
          </div>
          <div class="flex items-center gap-1.5 flex-wrap">
            <BiCategoryAlt className="h-4 w-4 text-slate-400" />
            {
              categories.map((category: string) => (
                <a
                  href={formatUrl(`/categories/${slugify(category)}`)}
                  class="bg-white/5 border border-white/10 text-slate-300 hover:text-white hover:border-white/30 px-2.5 py-0.5 rounded font-mono text-[11px] transition-all"
                >
                  {humanize(category)}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {
        image && (
          <div class="w-full mb-10 overflow-hidden rounded-2xl border border-white/10 shadow-2xl bg-[rgba(12,12,15,0.75)]">
            <Image
              src={formatUrl(image)}
              height={500}
              width={1000}
              alt={title}
              class="w-full object-cover max-h-[480px]"
            />
          </div>
        )
      }

      <div class="w-full">
        <div class="content mb-12 text-left bg-[rgba(12,12,15,0.4)] backdrop-blur-sm border border-white/5 rounded-2xl p-6 md:p-10 shadow-xl">
          <Content />
        </div>
        <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-white/10">
          <ul class="flex flex-wrap gap-2">
            {
              tags.map((tag: string) => (
                <li>
                  <a
                    href={formatUrl(`/tags/${slugify(tag)}`)}
                    class="inline-block rounded-lg bg-white/5 border border-white/10 px-3.5 py-1.5 font-mono text-xs text-slate-300 hover:text-white hover:border-white/30 transition duration-200"
                  >
                    #{humanize(tag)}
                  </a>
                </li>
              ))
            }
          </ul>
          <Share
            className="social-share"
            title={title}
            description={description}
            slug={post.id}
          />
        </div>
      </div>
    </article>
  </div>
</section>

<!-- similar posts -->
{
  similarPosts.length > 0 && (
    <section class="section pt-4 pb-16">
      <div class="container max-w-[900px]">
        <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-white">Similar Posts</h2>
        <SimilarPosts posts={similarPosts.slice(0, 3)} />
      </div>
    </section>
  )
}
