---
import Social from "@/components/Social.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";

const { author } = Astro.props;
const { title, image, social } = author.data;
const { Content } = await render(author);
---

<section class="container pt-16 md:pt-24">
  <div class="flex items-center gap-5">
    {image && <Image src={image} class="h-16 w-16 rounded-full border border-border" height={128} width={128} alt="" />}
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
      <Social source={social} className="social-icons -ml-2 mt-1" />
    </div>
  </div>
  <div class="content mt-6">
    <Content />
  </div>
</section>
