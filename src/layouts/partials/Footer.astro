---
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
---

<footer class="mt-24 border-t border-border">
  <div
    class="container-wide flex flex-col gap-6 py-10 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-center gap-3">
      <img src="/images/bloop.png" alt="Bloop, the Avenx.js mascot" width="36" height="36" class="h-9 w-9" />
      <div>
        <p class="font-medium text-text-dark">A frontend framework that can explain itself.</p>
        <p class="text-xs text-text-light">{config.params.copyright}</p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          menu.footer.map((item) => (
            <li>
              <a href={item.url} class="text-text transition-colors hover:text-text-dark">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
      <Social source={social.main} className="social-icons -mr-2" />
    </div>
  </div>
</footer>
