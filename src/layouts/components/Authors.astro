---
import { formatUrl } from "@/lib/utils/urlFormatter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  authors: CollectionEntry<"authors">[];
};
const { authors } = Astro.props;
---

<ul class="post-list">
  {
    authors.map((author) => (
      <li class="flex items-center gap-4 py-5">
        {author.data.image && (
          <Image src={formatUrl(author.data.image)} alt="" height={96} width={96} class="h-10 w-10 rounded-full border border-border" />
        )}
        <div>
          <a href={formatUrl(`/authors/${author.id}`)} class="font-semibold text-text-dark hover:text-primary">
            {author.data.title}
          </a>
          {author.data.description && <p class="text-sm text-text">{author.data.description}</p>}
        </div>
      </li>
    ))
  }
</ul>
