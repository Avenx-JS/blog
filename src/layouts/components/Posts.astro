---
import dateFormat from "@/lib/utils/dateFormat";
import { plainify } from "@/lib/utils/textConverter";
import { formatUrl } from "@/lib/utils/urlFormatter";
import type { CollectionEntry } from "astro:content";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const { className = "", posts } = Astro.props;
---

<ol class={`post-list ${className}`}>
  {
    posts.map((post) => (
      <li class="post-row">
        <time datetime={post.data.date?.toISOString()}>
          {post.data.date && dateFormat(post.data.date, "MMM d, yyyy")}
        </time>
        <div>
          <h2>
            <a href={formatUrl(`/${post.id}`)}>{plainify(post.data.title)}</a>
          </h2>
          <p>{post.data.description ?? plainify(post.body ?? "")}</p>
        </div>
      </li>
    ))
  }
</ol>
