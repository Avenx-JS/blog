---
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { formatUrl } from "@/lib/utils/urlFormatter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
};
const { posts } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
  {
    posts.map((post, i: number) => (
      <div class={`bg-[rgba(12,12,15,0.75)] backdrop-blur-md border border-white/10 rounded-2xl overflow-hidden p-5 hover:border-white/25 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group ${i === 2 ? "hidden md:flex" : ""}`}>
        <div>
          {post.data.image && (
            <a
              href={formatUrl(`/${post.id}`)}
              class="rounded-xl block overflow-hidden mb-4 relative border border-white/5"
            >
              <Image
                class="group-hover:scale-[1.03] transition duration-500 w-full object-cover max-h-[180px]"
                src={formatUrl(post.data.image)}
                alt={post.data.title}
                width={445}
                height={230}
              />
            </a>
          )}
          <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-slate-400 mb-3">
            <span class="flex items-center text-slate-400">
              <BiCalendarEdit className="mr-1 h-3.5 w-3.5 text-slate-400" />
              {dateFormat(post.data.date!)}
            </span>
            <div class="flex items-center gap-1 flex-wrap">
              <BiCategoryAlt className="h-3.5 w-3.5 text-slate-400" />
              {post.data.categories.map((category) => (
                <a
                  href={formatUrl(`/categories/${slugify(category)}`)}
                  class="bg-white/5 border border-white/10 text-slate-300 hover:text-white px-2 py-0.5 rounded font-mono text-[10px]"
                >
                  {humanize(category)}
                </a>
              ))}
            </div>
          </div>
          <h3 class="text-base font-bold text-white tracking-tight">
            <a
              href={formatUrl(`/${post.id}`)}
              class="block text-white hover:text-slate-300 transition duration-200"
            >
              {post.data.title}
            </a>
          </h3>
        </div>
      </div>
    ))
  }
</div>
