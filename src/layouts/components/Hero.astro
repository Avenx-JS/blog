---
import { formatUrl } from "@/lib/utils/urlFormatter";
---

<header class="hero" id="hero-banner">
  <div class="container">
    <div class="hero-content">
      <h1>
        <img src={formatUrl("/images/logo.svg")} alt="A" class="heading-logo" />venx.js Blog
      </h1>
      <p class="hero-tagline">Official Avenx.js Blog</p>
      <p class="hero-desc">
        News, tutorials, releases, and deep dives into the Avenx.js reactivity engine and ecosystem.
      </p>

      <!-- NPM copyable container -->
      <div class="install-box" id="hero-npm-install">
        <span class="install-text" id="npm-command-string">npm install avenx-core</span>
        <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <div class="copy-tooltip" id="install-tooltip">Copied!</div>
      </div>

      <div class="hero-buttons">
        <a href="#posts" class="btn btn-solid" id="hero-cta-primary">Explore Articles</a>
        <a href="https://github.com/Avenx-JS/avenx-js" target="_blank" rel="noopener noreferrer" class="btn btn-outline" id="hero-cta-secondary">Star on GitHub</a>
      </div>
    </div>
  </div>
</header>

<script>
  function copyNpmText() {
    const cmdText = document.getElementById('npm-command-string')?.innerText;
    const tooltip = document.getElementById('install-tooltip');

    if (cmdText && tooltip) {
      navigator.clipboard.writeText(cmdText).then(() => {
        tooltip.classList.add('show');
        setTimeout(() => {
          tooltip.classList.remove('show');
        }, 1800);
      }).catch(e => {
        console.error("Clipboard copy failed: ", e);
      });
    }
  }

  // Bind event listener to the copyable box
  document.getElementById('hero-npm-install')?.addEventListener('click', copyNpmText);
</script>

<style>
  .hero {
    min-height: 75vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.85)), url('/images/hero.jpg');
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
    padding: 5rem 0;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 35%;
    background: linear-gradient(to top, #000000, transparent);
    pointer-events: none;
  }

  .hero-content {
    animation: fadeIn 1.2s ease-out forwards;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h1 {
    font-size: 5.5rem;
    font-weight: 900;
    letter-spacing: -4px;
    line-height: 1;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 3.5rem;
      letter-spacing: -2px;
    }
  }

  .heading-logo {
    height: 1.2em;
    width: auto;
    transform: translateY(0.001em);
    margin-right: -0.12em;
    display: inline-block;
  }

  /* Hero Subtext */
  p.hero-tagline {
    font-size: 1.15rem;
    color: #ffffff;
    font-weight: 600;
    margin-bottom: 1.5rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  p.hero-desc {
    font-size: 1.15rem;
    color: #94a3b8;
    max-width: 620px;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  /* NPM install capsule */
  .install-box {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: rgba(13, 13, 16, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.75rem 1.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    margin-bottom: 2rem;
    backdrop-filter: blur(8px);
  }

  .install-box:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(20, 20, 25, 0.95);
  }

  .install-text {
    color: #ffffff;
    user-select: all;
  }

  .install-text::before {
    content: '$ ';
    color: #94a3b8;
  }

  .copy-icon {
    opacity: 0.5;
    transition: opacity 0.2s ease;
    color: #ffffff;
  }

  .install-box:hover .copy-icon {
    opacity: 1;
  }

  .copy-tooltip {
    position: absolute;
    top: -38px;
    right: 50%;
    transform: translateX(50%) translateY(5px);
    background: #ffffff;
    color: #000000;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s ease;
  }

  .copy-tooltip.show {
    opacity: 1;
    transform: translateX(50%) translateY(0);
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
  }
</style>
