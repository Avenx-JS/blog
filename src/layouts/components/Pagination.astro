---
const { section, currentPage, totalPages } = Astro.props;

const base = section ? `/${section}` : "";
const prevHref = currentPage === 2 ? base || "/" : `${base}/page/${currentPage - 1}`;
const nextHref = `${base}/page/${currentPage + 1}`;
const hasPrevPage = currentPage > 1;
const hasNextPage = totalPages > currentPage;
---

{
  totalPages > 1 && (
    <nav class="mt-10 flex items-center justify-between text-sm" aria-label="Pagination">
      {hasPrevPage ? (
        <a href={prevHref} class="btn btn-outline">← Newer</a>
      ) : (
        <span />
      )}
      <span class="font-mono text-xs text-text-light">
        {currentPage} / {totalPages}
      </span>
      {hasNextPage ? (
        <a href={nextHref} class="btn btn-outline">Older →</a>
      ) : (
        <span />
      )}
    </nav>
  )
}
