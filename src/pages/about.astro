---
import Base from "@/layouts/Base.astro";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";

const entry = (await getEntry("about", "-index")) as CollectionEntry<"about">;
const { Content } = await render(entry);
const { title, meta_title, description, image } = entry.data;
---

<Base title={title} meta_title={meta_title} description={description} image={image}>
  <section class="container pt-16 md:pt-24">
    <img
      src="/images/bloop.png"
      alt="Bloop, the Avenx.js mascot"
      width="96"
      height="96"
      class="mb-8 h-24 w-24"
    />
    <h1 class="page-heading mb-8">{title}</h1>
    <div class="content">
      <Content />
    </div>
  </section>
</Base>
