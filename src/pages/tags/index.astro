---
import Base from "@/layouts/Base.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { humanize, slugify } from "@/lib/utils/textConverter";

const items = await getTaxonomy("posts", "tags");
const all = await getAllTaxonomy("posts", "tags");
const count = (item: string) => all.filter((x) => x === item).length;
// show the name as written in frontmatter (slugs drop dots, e.g. "v1.0.0")
const posts = await getSinglePage("posts");
const names = new Map<string, string>();
posts.forEach((p) => p.data.tags.forEach((t: string) => names.set(slugify(t)!, t)));
---

<Base title={"Tags"}>
  <section class="container pt-16 md:pt-24">
    <h1 class="page-heading">Tags</h1>
    <ul class="flex flex-wrap gap-2">
      {
        items.sort().map((item) => (
          <li>
            <a href={`/tags/${item}`} class="tag">
              {names.get(item) ?? humanize(item)}
              <span class="ml-1 text-text-light">{count(item)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
