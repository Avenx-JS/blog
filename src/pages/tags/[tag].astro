---
import Posts from "@/components/Posts.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { humanize, slugify } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const tags = await getTaxonomy("posts", "tags");

  return tags.map((tag) => {
    return {
      params: { tag },
    };
  });
}

const { tag } = Astro.params;

const posts = await getSinglePage("posts");
const filterByTags = taxonomyFilter(posts, "tags", tag);
const sortedPosts = sortByDate(filterByTags);

const original = posts
  .flatMap((p) => p.data.tags as string[])
  .find((t) => slugify(t) === tag);
const title = original ?? humanize(tag || "");
---

<Base title={title || "Tag"}>
  <section class="container pt-16 md:pt-24">
    <a href="/tags" class="eyebrow transition-colors hover:text-text-dark">Tag</a>
    <h1 class="page-heading mt-3">{title}</h1>
    <Posts posts={sortedPosts} />
  </section>
</Base>
