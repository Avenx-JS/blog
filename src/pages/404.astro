---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found">
  <section class="container py-24 text-center">
    <img src="/images/bloop.png" alt="Bloop, the Avenx.js mascot" width="160" height="160" class="mx-auto mb-8 h-40 w-40" />
    <p class="eyebrow mb-3">404</p>
    <h1 class="text-3xl font-semibold tracking-tight">Bloop couldn't find that page.</h1>
    <p class="mt-3 text-text">It may have moved, or it never existed.</p>
    <a href="/" class="btn btn-primary mt-8">Back to all posts</a>
  </section>
</Base>
